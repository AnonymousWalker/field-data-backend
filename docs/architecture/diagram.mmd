flowchart TD
  subgraph sys_umbrella["Dev workflow"]
    grp_dev_reset[["make reset<br/>nuke → up → seed → smoke"]]:::tool
    script_seed_seed_sh[["seed/seed.sh"]]:::tool
  end
  subgraph sys_fdb["fdb tooling"]
    grp_fdb_cli[["fdb CLI<br/>tools/cli/fdb"]]:::tool
    grp_fdb_core["fdb core<br/>import · put · status"]:::code
    subgraph svc_fdb_api["fdb-api"]
      direction TB
      grp_fdb_http["HTTP API<br/>/import · /repos/…/contents · /pipeline"]:::fn
    end
  end
  subgraph sys_wacs["WACS"]
    svc_wacs("wacs<br/>built here"):::svc
    svc_wacs_db[("wacs-db<br/>mariadb:10.11")]:::store
    svc_wacs_redis[("wacs-redis<br/>valkey:7.2")]:::store
  end
  subgraph sys_srp["ScriptureRenderingPipeline"]
    svc_BTTWriterCatalog("BTTWriterCatalog<br/>production only"):::inactive
    svc_VerseReportingProcessor("VerseReportingProcessor<br/>production only"):::inactive
    subgraph svc_srp_webhook["srp-webhook"]
      direction TB
      fn_srp_MergeWebhook["MergeWebhook<br/>HTTP /merge"]:::fn
      fn_srp_Webhook["Webhook<br/>HTTP /webhook"]:::fn
      grp_srp_http["On-demand HTTP<br/>RenderDoc · CheckRepoExists · (Un)RegisterWebhook"]:::fn
    end
    subgraph svc_srp_worker["srp-worker"]
      direction TB
      fn_srp_MergeTrigger["MergeTrigger<br/>Service Bus trigger"]:::fn
      fn_srp_ProgressReporting["ProgressReporting<br/>Service Bus trigger"]:::fn
      fn_srp_RenderingTrigger["RenderingTrigger<br/>Service Bus trigger"]:::fn
      fn_srp_RepoAnalysisTrigger["RepoAnalysisTrigger<br/>Service Bus trigger"]:::fn
      grp_srp_dispatch["WebhookDispatcher<br/>Service Bus trigger ×2"]:::fn
      grp_srp_renderers["Renderers<br/>Bible · tN · tQ · tW · tA · commentary"]:::fn
    end
  end
  subgraph sys_infra["Azure emulation"]
    subgraph svc_azurite["azurite"]
      direction TB
      blob__web[("$web<br/>blob container")]:::store
      blob_template[("template<br/>blob container")]:::store
    end
    subgraph svc_servicebus["servicebus"]
      direction TB
      topic_audiobiel{{"audiobiel<br/>topic"}}:::topic
      topic_mergedresult{{"mergedresult<br/>topic"}}:::topic
      topic_mergerequest{{"mergerequest<br/>topic"}}:::topic
      topic_repoanalysisresult{{"repoanalysisresult<br/>topic"}}:::topic
      topic_reporendered{{"reporendered<br/>topic"}}:::topic
      topic_versecountingresult{{"versecountingresult<br/>topic"}}:::topic
      topic_wacsevent{{"wacsevent<br/>topic"}}:::topic
    end
  end
  subgraph sys_languageapi["languageapi"]
    subgraph svc_lapi_controller["lapi-controller"]
      direction TB
      fn_lapi_waAudioRenderings["waAudioRenderings<br/>Service Bus trigger"]:::fn
      fn_lapi_waLangApiGitTopics["waLangApiGitTopics<br/>Service Bus trigger"]:::fn
      fn_lapi_waLangApiRenderings["waLangApiRenderings<br/>Service Bus trigger"]:::fn
      grp_lapi_routes["REST routes<br/>/api/language · content · git · rendering …"]:::fn
      grp_lapi_timers["Timers<br/>localizations · GL USFM sources"]:::fn
    end
    svc_lapi_hasura("lapi-hasura<br/>graphql-engine:v2.30.1.cli-m"):::svc
    svc_lapi_migrate("lapi-migrate<br/>built here"):::svc
    svc_lapi_postgres[("lapi-postgres<br/>postgres:15.7")]:::store
  end

