# Copy to .env to override defaults. Everything here is optional.

# --- Host ports ---
# WACS_HTTP_PORT=3000
# WACS_SSH_PORT=2222
# HASURA_PORT=8080
# LAPI_CONTROLLER_PORT=7072
# SRP_WEBHOOK_PORT=7071
# AZURITE_BLOB_PORT=10000
# AZURITE_QUEUE_PORT=10001
# AZURITE_TABLE_PORT=10002
# SERVICEBUS_PORT=5672
# SERVICEBUS_MGMT_PORT=5300
# FDB_API_PORT=7080          # fdb HTTP helper (published on 127.0.0.1 only)

# --- Seeded WACS admin (also used by the SRP worker to read repos) ---
# WACS_ADMIN_USER=fdbadmin
# WACS_ADMIN_PASSWORD=fdbadmin123

# --- Demo content ---
# DEMO_ORG=fielddata
# DEMO_REPO=en_ulb

# --- Builds ---
# Use the published WACS image instead of building repos/wacs (e.g. if the Go module proxy is unreachable).
# WACS_PREBUILT=1
# WACS_IMAGE=wycliffeassociates/wacs:latest

# PEM bundle to trust during image builds, for networks with a TLS-intercepting proxy.
# EXTRA_CA_FILE=/usr/local/share/ca-certificates/corp.crt

# Service Bus emulator's SQL Server SA password.
# SB_SQL_PASSWORD=FieldData!Local123

# Smoke test wait (seconds) per async step.
# SMOKE_TIMEOUT=180
