# Local overrides layered on top of repos/wacs/.env (later env_file entries win).
# Only values that must differ for the umbrella stack belong here.

# Service names are prefixed in the umbrella stack.
GITEA__database__HOST=wacs-db
GITEA__cache__HOST=redis://wacs-redis:6379/0
GITEA__queue__CONN_STR=redis://wacs-redis:6379/0
GITEA__session__PROVIDER_CONFIG=redis://wacs-redis:6379/0

# Allow Gitea to deliver webhooks to other containers on the compose network (default "external" blocks them).
GITEA__webhook__ALLOWED_HOST_LIST=private,loopback

# Make sign-up frictionless for demos.
GITEA__service__ENABLE_CAPTCHA=false

# Placeholders the upstream compose passes through; not in upstream .env.
LINTER_BASE_LINK=https://usfmlinter.walink.org/ListScans/
